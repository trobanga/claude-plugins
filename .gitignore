# Local Claude Code state (settings.local.json, worktrees, scheduled tasks)
.claude/
# except in eval fixtures, which model a project's own .claude/ folder
!plugins/**/evals/**/.claude/

# Python / type-checker caches
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Editor and OS
.idea/
.vscode/
.DS_Store

# Results of claude plugin eval
**/evals/results/
